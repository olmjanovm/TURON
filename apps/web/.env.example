# apps/web (Next.js) muhit o'zgaruvchilari

# Eski Fastify backend manzili — /api/* shu yerga proxy qilinadi (FAZA A1/A2)
# Server-only (route handlers/middleware). NEXT_PUBLIC_API_URL fallback sifatida ishlatiladi.
BACKEND_API_URL="https://turonkafe.duckdns.org"
NEXT_PUBLIC_API_URL="https://turonkafe.duckdns.org"

# Telegram bot (FAZA A2 auth)
NEXT_PUBLIC_TELEGRAM_BOT_NAME="TuronKafeBot"

# ── Xaritalar — Yandex Maps (⚠️ VITE_* ESKIRGAN — Next.js o'qimaydi) ──
# Kod ANIQ shu nomlarni o'qiydi (apps/web/src/lib/yandex-maps.ts:21-25):
#   NEXT_PUBLIC_YANDEX_MAP_API_KEY → NEXT_PUBLIC_MAP_API_KEY (legacy) → dev fallback
# BROWSER (JS Maps: xarita + geocode + multiRouter navigatsiya chizig'i):
NEXT_PUBLIC_YANDEX_MAP_API_KEY="c3e2b675-cbbf-4886-b77a-3ed4e0d4f3f8"
NEXT_PUBLIC_MAP_LANGUAGE="uz_UZ"
NEXT_PUBLIC_MAP_API_KEY=""   # legacy fallback (ixtiyoriy)

# SERVER-SIDE (NEXT_PUBLIC_ EMAS — browserga chiqmaydi).
# /api/maps/route HTTP Router proxy ishlatadi (route.ts:23):
# navigatsiya chizig'i + traffik + turn-by-turn sifati uchun.
YANDEX_ROUTER_API_KEY="c3e2b675-cbbf-4886-b77a-3ed4e0d4f3f8"

# Supabase Storage — admin mahsulot rasmlarini yuklash uchun (product-images bucket)
NEXT_PUBLIC_SUPABASE_URL="https://quhgjrpqjqaoalkthufu.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
NEXT_PUBLIC_SUPABASE_BUCKET="product-images"

# Socket.io gateway (FAZA 2 — courier realtime + GPS)
# Bo'sh bo'lsa same-origin'ga ulanishga urinadi (dev uchun).
# Prod: alohida deploy qilingan @turon/socket-gateway URL'ini ko'rsating.
NEXT_PUBLIC_SOCKET_URL=""
