# apps/web (Next.js) muhit o'zgaruvchilari

# Eski Fastify backend manzili — /api/* shu yerga proxy qilinadi (FAZA A1/A2)
# Server-only (route handlers/middleware). NEXT_PUBLIC_API_URL fallback sifatida ishlatiladi.
BACKEND_API_URL="https://turonkafe.duckdns.org"
NEXT_PUBLIC_API_URL="https://turonkafe.duckdns.org"

# Telegram bot (FAZA A2 auth)
NEXT_PUBLIC_TELEGRAM_BOT_NAME="TuronKafeBot"

# ── Xaritalar — Yandex Maps (2026-06-19 YANGI maxsus kalitlar, har biri alohida) ──
