# ───────────────────────────────────────────────────────────────
# Socket gateway — production env
# Fastify backend bilan bir xil JWT_SECRET, BACKEND_URL ishlatadi
# ───────────────────────────────────────────────────────────────

# === MAJBURIY ==============================================
JWT_SECRET=your-jwt-secret-must-match-backend

# === ASOSIY (default qiymatlar mos kelishi mumkin) =========
PORT=3030
HOST=0.0.0.0
LOG_LEVEL=info
AUTH_COOKIE_NAME=turon_token

# Webdan kelgan ulanishlar uchun ruxsat berilgan originlar
CORS_ORIGINS=https://turon-miniapp.vercel.app,http://localhost:3000

# Backend REST manzili (GPS batch yozish + cross-call'lar uchun)
BACKEND_URL=https://turonkafe.duckdns.org

# === REDIS (ixtiyoriy — horizontal scale uchun) ============
# Bo'sh bo'lsa: single-instance rejimida ishlaydi (in-memory)
# REDIS_URL=redis://default:password@host:6379

# === BACKEND → GATEWAY events =============================
# Backend assignment yaratganda gateway'ga POST qiladi (X-Webhook-Secret)
# Bo'sh bo'lsa /webhook/* endpoints o'chiriladi
# Backendda ham xuddi shu qiymat (SOCKET_WEBHOOK_SECRET) bo'lishi kerak
WEBHOOK_SECRET=

# === TUNING ===============================================
GPS_DB_FLUSH_MS=20000
GPS_REDIS_TTL_S=60
