# Socket gateway — required env
JWT_SECRET=your-jwt-secret-must-match-backend

# Optional
PORT=3030
HOST=0.0.0.0
AUTH_COOKIE_NAME=turon_token
CORS_ORIGINS=https://turon-miniapp.vercel.app,http://localhost:3000

# Backend REST for DB writes (GPS batched flush)
BACKEND_URL=https://turonkafe.duckdns.org

# Redis (optional — enables horizontal scale + persistent live coords)
REDIS_URL=

# Tuning
GPS_DB_FLUSH_MS=20000
GPS_REDIS_TTL_S=60
